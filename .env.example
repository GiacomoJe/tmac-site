APP_NAME="TMAC Import"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tmac_site
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@tmacimport.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Comercial - destinatário das notificações de cotação
QUOTE_COMMERCIAL_EMAIL=comercial@tmacimport.com.br

# Integrações marketing
RDSTATION_PUBLIC_TOKEN=
RDSTATION_PRIVATE_TOKEN=
RDSTATION_ENABLED=false

GTM_CONTAINER_ID=
GOOGLE_ADS_CONVERSION_ID=

# WhatsApp principal (institucional)
WHATSAPP_NUMBER=5511999999999
WHATSAPP_DEFAULT_MESSAGE="Olá, gostaria de mais informações sobre os produtos da TMAC."

# Busca - quando passar para Meilisearch:
SCOUT_DRIVER=database
MEILISEARCH_HOST=
MEILISEARCH_KEY=

VITE_APP_NAME="${APP_NAME}"
